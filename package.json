{
  "name": "pogo-buddy",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "cargo tauri dev",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "tsx --test test/**/*.test.ts",
    "version:bump": "tsx scripts/bump-version.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate-data": "tsx scripts/generate-migrations-data.ts",
    "build:dummy-db": "tsx scripts/build-dummy-db.ts",
    "studio": "drizzle-kit studio --config drizzle.config.studio.ts",
    "ingest": "tsx scripts/ingest/ingest.ts",
    "ingest:check": "tsx scripts/ingest/ingest.ts --check",
    "android:build": "cargo tauri android build --debug",
    "android:release": "cargo tauri android build"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "better-sqlite3": "^13.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "drizzle-orm": "^0.44.6",
    "vue": "^3.5.40"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.35.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
